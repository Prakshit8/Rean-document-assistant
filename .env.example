GROQ_API_KEY=your_groq_api_key_here

OPENAI_API_KEY=your_openai_api_key_here

LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

EMBEDDING_MODEL=all-MiniLM-L6-v2

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

VECTOR_STORE_PATH=data/vector_store
INDEX_TYPE=flat

TOP_K_RESULTS=5
USE_HYBRID_SEARCH=false
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
